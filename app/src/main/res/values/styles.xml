<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Memento"/>
    
    <style name="Memento.OnboardingTitle">
        <item name="android:fontFamily">@font/el_messiri_semibold</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">@color/mem_toolbar</item>
    </style>

    <style name="Memento.OnboardingBody">
        <item name="android:fontFamily">@font/el_messiri_semibold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/mem_text_dark</item>
    </style>
    
    <style name="Memento.ButtonText">
        <item name="android:fontFamily">@font/el_messiri_semibold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Memento.VignetteCardTitle">
        <item name="android:fontFamily">@font/el_messiri_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/mem_text_dark</item>
    </style>

    <style name="Memento.AlbumCardTitle">
        <item name="android:fontFamily">@font/el_messiri_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/mem_text_dark</item>
    </style>

    <style name="Memento.CardDescription">
        <item name="android:fontFamily">@font/el_messiri</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/mem_text_pale</item>
    </style>

    <style name="Memento.ToolbarTitle">
        <item name="android:fontFamily">@font/el_messiri_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Memento.Subtitle">
        <item name="android:fontFamily">@font/el_messiri_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/mem_text_dark</item>
    </style>
    
    <style name="Memento.ButtonBase">
        <item name="android:background">@drawable/button_big</item>
        <item name="android:textAppearance">@style/Memento.ButtonText</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:outlineAmbientShadowColor">@color/black</item>
        <item name="android:outlineSpotShadowColor">@color/black</item>
    </style>

    <style name="Memento.BigButton" parent="Memento.ButtonBase">
        <item name="android:width">296dp</item>
        <item name="android:height">48dp</item>
    </style>

    <style name="Memento.SmallButton" parent="Memento.ButtonBase">
        <item name="android:width">100dp</item>
        <item name="android:height">48dp</item>
    </style>

    <style name="Memento.CircleButton" parent="Memento.ButtonBase">
        <item name="android:background">@drawable/button_circle</item>
        <item name="android:width">56dp</item>
        <item name="android:height">56dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Memento.Input">
        <item name="android:background">@drawable/input_background</item>
        <item name="android:textColor">@color/mem_text_dark</item>
        <item name="android:textColorHint">@color/mem_text_pale</item>
        <item name="android:fontFamily">@font/el_messiri_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">35dp</item>
    </style>

    <style name="Memento.Input.Multiline" parent="Memento.Input">
        <item name="android:gravity">top|start</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
        <item name="android:minLines">5</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Memento.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_color</item>
        <item name="trackTint">@color/switch_track_color</item>
    </style>

    <style name="Memento.Input.Dropdown" parent="Memento.Input">
        <item name="android:focusable">false</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:inputType">none</item>
    </style>
    
</resources>