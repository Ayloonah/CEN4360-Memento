<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AlbumFragment" >

    <com.luanya.memento.ui.components.MementoToolbar
        android:id="@+id/albumDetailToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/albumDetailHeader"
        style="@style/Memento.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/header_vignettes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/albumDetailToolbar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/albumDetailRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/albumDetailHeader"
        tools:listitem="@layout/item_vignette"
        android:paddingBottom="80dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/albumDetailEmpty"
        style="@style/Memento.CardDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="@string/label_empty_album"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/albumDetailHeader"
        app:layout_constraintVertical_bias="0.05" />

    <ImageButton
        android:id="@+id/albumDetailAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_circle"
        android:contentDescription="@string/icon_add"
        android:elevation="3dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_plus"
        app:layout_constraintBottom_toBottomOf="@+id/albumDetailRecycler"
        app:layout_constraintEnd_toEndOf="@+id/albumDetailRecycler" />

</androidx.constraintlayout.widget.ConstraintLayout>