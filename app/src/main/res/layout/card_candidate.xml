<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="328dp"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" >

    <!-- defaults to lake eola park · 4:15 pm -->
    <TextView
        android:id="@+id/candidateTitle"
        style="@style/Memento.VignetteCardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/card_candidate_title"
        app:layout_constraintEnd_toStartOf="@id/candidateSuggestedIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- sparkle in the corner -->
    <ImageView
        android:id="@+id/candidateSuggestedIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/card_suggested"
        app:srcCompat="@drawable/icon_suggested"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- defaults to september 23, 2026 -->
    <TextView
        android:id="@+id/candidateDate"
        style="@style/Memento.CardDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/card_candidate_date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/candidateTitle" />

    <!-- defaults to partly cloudy · 81°f -->
    <TextView
        android:id="@+id/candidateWeather"
        style="@style/Memento.CardDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/card_candidate_weather"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/candidateDate" />

    <!-- reason icon (defaults to the new location flag) -->
    <ImageView
        android:id="@+id/candidateReasonIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/card_reason"
        app:srcCompat="@drawable/track_location"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/candidateWeather" />

    <!-- reason label (defaults to new location) -->
    <TextView
        android:id="@+id/candidateReason"
        style="@style/Memento.CardDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/reason_new_location"
        android:textColor="@color/mem_text_dark"
        app:layout_constraintBottom_toBottomOf="@id/candidateReasonIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/candidateReasonIcon"
        app:layout_constraintTop_toTopOf="@id/candidateReasonIcon" />

</androidx.constraintlayout.widget.ConstraintLayout>