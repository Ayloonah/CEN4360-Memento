<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="328dp"
    android:layout_height="112dp"
    android:background="@drawable/card_background"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" >

    <!-- Defaults to an image icon -->
    <ImageView
        android:id="@+id/vignetteImage"
        android:layout_width="104dp"
        android:layout_height="88dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/card_vignette_image_rounded"
        android:clipToOutline="true"
        android:contentDescription="@string/card_vignette"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_picture"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Defaults to Pretty Sunset -->
    <TextView
        android:id="@+id/vignetteTitle"
        style="@style/Memento.VignetteCardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:text="@string/card_vignette_title"
        app:layout_constraintBottom_toTopOf="@id/vignetteDate"
        app:layout_constraintEnd_toStartOf="@+id/vignetteFavoriteButton"
        app:layout_constraintStart_toEndOf="@id/vignetteImage"
        app:layout_constraintTop_toTopOf="@id/vignetteImage"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Defaults to September 15, 2026 -->
    <TextView
        android:id="@+id/vignetteDate"
        style="@style/Memento.CardDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/card_vignette_date"
        app:layout_constraintStart_toEndOf="@id/vignetteImage"
        app:layout_constraintTop_toBottomOf="@id/vignetteTitle"
        app:layout_constraintBottom_toTopOf="@id/vignetteLocation" />

    <!-- This text won't be visible unless made manually
    visible in Java, this is so it doesn't show by default
    for users who do not track location
    When visible, defaults to UCF -->
    <TextView
        android:id="@+id/vignetteLocation"
        style="@style/Memento.CardDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/card_vignette_location"
        app:layout_constraintStart_toEndOf="@id/vignetteImage"
        app:layout_constraintTop_toBottomOf="@id/vignetteDate"
        app:layout_constraintBottom_toTopOf="@id/vignetteWeather"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- This text won't be visible unless made manually
    visible in Java, this is so it doesn't show by default
    for users who do not track weather
    When visible, defaults to Clear · 84°F -->
    <TextView
        android:id="@+id/vignetteWeather"
        style="@style/Memento.CardDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/card_vignette_weather"
        app:layout_constraintStart_toEndOf="@id/vignetteImage"
        app:layout_constraintTop_toBottomOf="@id/vignetteLocation"
        app:layout_constraintBottom_toBottomOf="@id/vignetteImage"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Defaults to not favorite -->
    <ImageButton
        android:id="@+id/vignetteFavoriteButton"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/card_favorite"
        app:srcCompat="@drawable/icon_favorite_empty"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- This icon won't be visible unless made manually
    visible in Java, this is so it doesn't show by default
    for users who do not track mood
    When visible, defaults to super happy -->
    <ImageView
        android:id="@+id/vignetteMoodIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/card_mood"
        app:srcCompat="@drawable/mood_super_happy"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>