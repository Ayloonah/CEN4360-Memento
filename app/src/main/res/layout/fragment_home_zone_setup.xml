<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeZoneSetup" >

    <TextView
        android:id="@+id/textView_home_title"
        style="@style/Memento.OnboardingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:gravity="center_horizontal"
        android:lineSpacingMultiplier="0.75"
        android:shadowColor="@android:color/darker_gray"
        android:shadowDy="8"
        android:shadowRadius="4"
        android:text="@string/onboarding_home"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8" />

    <TextView
        android:id="@+id/textView_home_instr"
        style="@style/Memento.OnboardingBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:gravity="center_horizontal"
        android:lineSpacingMultiplier="0.75"
        android:text="@string/onboarding_home_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_home_title"
        app:layout_constraintWidth_percent="0.7" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_home"
        style="@style/Memento.BigButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="@string/onboarding_home_button"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/button_home"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_home_instr"
        app:layout_constraintWidth_percent="0.8">

        <TextView
            android:id="@+id/label_HomeZone"
            style="@style/Memento.VignetteCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fields_home" />

        <TextView
            android:id="@+id/field_Home"
            style="@style/Memento.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clickable="true"
            app:drawableEndCompat="@drawable/icon_pin"
            app:drawableTint="@color/mem_toolbar"
            android:focusable="true"
            android:hint="@string/fields_home_default"
            android:minHeight="44dp" />

        <TextView
            android:id="@+id/label_ExclusionRadius"
            style="@style/Memento.VignetteCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fields_exclude" />

        <TextView
            android:id="@+id/field_Exclude"
            style="@style/Memento.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="44dp"
            android:text="@string/fields_exclude_default" />

        <TextView
            android:id="@+id/textView_Skip"
            style="@style/Memento.VignetteCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="@string/onboarding_home_skip" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>