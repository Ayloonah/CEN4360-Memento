<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chooseVignetteRow"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/input_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <!-- thumbnail (vignette photo or the picture icon if it has none) -->
    <ImageView
        android:id="@+id/chooseVignetteImage"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/card_vignette_image_rounded"
        android:clipToOutline="true"
        android:contentDescription="@string/card_vignette"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_picture" />

    <!-- vignette title -->
    <TextView
        android:id="@+id/chooseVignetteTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/el_messiri_semibold"
        android:maxLines="1"
        android:textColor="@color/mem_text_dark"
        android:textSize="16sp"
        tools:text="Lake Eola Afternoon" />

</LinearLayout>