<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Settings" >

    <com.luanya.memento.ui.components.MementoToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:toolbarTitle="@string/toolbar_settings">

    </com.luanya.memento.ui.components.MementoToolbar>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settingsToolbar">

        <!-- white card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- title (required) -->

            <TextView
                android:id="@+id/TextView_Privacy&Tracking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fields_privacy"
                android:textAppearance="@style/Memento.Subtitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_track_location"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_track_location" />

                <Switch
                    android:id="@+id/switch_settings_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|center_vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:scaleX="1"
                    android:thumbTint="@color/switch_color"
                    android:trackTint="@color/switch_color" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_track_weather"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_track_weather" />

                <Switch
                    android:id="@+id/switch_settings_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|center_vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:scrollbarSize="4dp"
                    android:thumbTint="@color/switch_color"
                    android:trackTint="@color/switch_color" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_track_mood"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_track_mood" />

                <Switch
                    android:id="@+id/switch_settings_mood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|center_vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:scrollbarSize="4dp"
                    android:thumbTint="@color/switch_color"
                    android:trackTint="@color/switch_color" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_track_activity"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_track_activity" />

                <Switch
                    android:id="@+id/switch_settings_activity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|center_vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:scrollbarSize="4dp"
                    android:thumbTint="@color/switch_color"
                    android:trackTint="@color/switch_color" />
            </LinearLayout>

            <!-- photo (optional) -->

            <!-- date and time -->

            <TextView
                android:id="@+id/textView_settings_homeZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fields_home"
                android:textAppearance="@style/Memento.Subtitle" />

            <TextView
                android:id="@+id/editText_settings_location"
                style="@style/Memento.Input"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:drawableEnd="@drawable/icon_pin"
                android:focusable="true"
                tools:text="@string/fields_home_default" />

            <!-- location and weather side by side -->

            <TextView
                android:id="@+id/textView_settings_exclude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fields_exclude"
                android:textAppearance="@style/Memento.Subtitle" />

            <TextView
                android:id="@+id/editText_settings_exclude"
                style="@style/Memento.Input"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                tools:text="@string/fields_exclude_default" />

            <TextView
                android:id="@+id/textView_settings_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fields_theme"
                android:textAppearance="@style/Memento.Subtitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_notificationsLabel"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/fields_enable_notifications" />

                <Switch
                    android:id="@+id/switch_settings_notifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|center_vertical"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:scrollbarSize="4dp"
                    android:thumbTint="@color/switch_color"
                    android:trackTint="@color/switch_color" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_reminder"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="109dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/fields_reminder" />

                <TextView
                    android:id="@+id/editText_settings_theme2"
                    style="@style/Memento.Input"
                    android:layout_width="20dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:drawableEnd="@drawable/icon_down"
                    android:focusable="true"
                    tools:text="@string/fields_reminder_default" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_frequency"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="107dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/fields_frequency" />

                <TextView
                    android:id="@+id/editText_settings_theme3"
                    style="@style/Memento.Input"
                    android:layout_width="20dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:drawableEnd="@drawable/icon_down"
                    android:focusable="true"
                    tools:text="@string/fields_frequency_default" />
            </LinearLayout>

            <TextView
                android:id="@+id/textView_settings_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fields_theme"
                android:textAppearance="@style/Memento.Subtitle" />

            <TextView
                android:id="@+id/editText_settings_theme"
                style="@style/Memento.Input"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:drawableEnd="@drawable/icon_down"
                android:focusable="true"
                tools:text="@string/fields_theme_default" />

            <!-- mood faces in the same 1-5 order as the adapter -->

            <!-- journal -->

            <!-- save -->
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>