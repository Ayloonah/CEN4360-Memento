<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Settings" >

    <com.luanya.memento.ui.components.MementoToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:toolbarTitle="@string/toolbar_settings">

    </com.luanya.memento.ui.components.MementoToolbar>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settingsToolbar">

        <!-- white card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- privacy and tracking -->
            <TextView
                android:id="@+id/TextView_PrivacyAndTracking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fields_privacy"
                android:textAppearance="@style/Memento.Subtitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_track_location"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_track_location" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_settings_location"
                    style="@style/Memento.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_track_weather"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_track_weather" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_settings_weather"
                    style="@style/Memento.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_track_mood"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_track_mood" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_settings_mood"
                    style="@style/Memento.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_track_activity"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_track_activity" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_settings_activity"
                    style="@style/Memento.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- home zone -->
            <TextView
                android:id="@+id/textView_settings_homeZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fields_home"
                android:textAppearance="@style/Memento.Subtitle" />

            <TextView
                android:id="@+id/field_settings_home"
                style="@style/Memento.Input"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:hint="@string/fields_home_default"
                app:drawableEndCompat="@drawable/icon_pin"
                app:drawableTint="@color/mem_toolbar" />

            <!-- exclusion radius -->
            <TextView
                android:id="@+id/textView_settings_exclude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fields_exclude"
                android:textAppearance="@style/Memento.Subtitle" />

            <TextView
                android:id="@+id/field_settings_exclude"
                style="@style/Memento.Input"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/fields_exclude_default" />

            <!-- notifications -->
            <TextView
                android:id="@+id/textView_settings_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fields_notifications"
                android:textAppearance="@style/Memento.Subtitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_notificationsLabel"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_enable_notifications" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_settings_notifications"
                    style="@style/Memento.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_reminder"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_reminder" />

                <TextView
                    android:id="@+id/field_settings_reminder"
                    style="@style/Memento.Input"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/fields_reminder_default"
                    app:drawableEndCompat="@drawable/icon_down"
                    app:drawableTint="@color/mem_toolbar" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView_settings_frequency"
                    style="@style/Memento.VignetteCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fields_frequency" />

                <TextView
                    android:id="@+id/field_settings_frequency"
                    style="@style/Memento.Input"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/fields_frequency_default"
                    app:drawableEndCompat="@drawable/icon_down"
                    app:drawableTint="@color/mem_toolbar" />

            </LinearLayout>

            <!-- theme -->
            <TextView
                android:id="@+id/textView_settings_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fields_theme"
                android:textAppearance="@style/Memento.Subtitle" />

            <TextView
                android:id="@+id/field_settings_theme"
                style="@style/Memento.Input"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/fields_theme_default"
                app:drawableEndCompat="@drawable/icon_down"
                app:drawableTint="@color/mem_toolbar" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>