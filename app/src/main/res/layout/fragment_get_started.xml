<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GetStarted" >

    <TextView
        android:id="@+id/textView_onboarding_title"
        style="@style/Memento.OnboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        app:layout_constraintVertical_chainStyle="spread_inside"
        android:shadowColor="@android:color/darker_gray"
        android:shadowDy="8"
        android:shadowRadius="4"
        android:text="@string/onboarding_main"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView_onboarding1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView_onboarding1"
        style="@style/Memento.OnboardingBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:lineSpacingMultiplier="0.75"
        android:text="@string/onboarding_main_1"
        app:layout_constraintBottom_toTopOf="@+id/imageView_onboarding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_onboarding_title"
        app:layout_constraintWidth_percent="0.70" />

    <ImageView
        android:id="@+id/imageView_onboarding"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="@string/onboarding_picture_stack"
        android:src="@drawable/picture_stack"
        app:layout_constraintBottom_toTopOf="@+id/textView_onboarding2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_onboarding1" />

    <TextView
        android:id="@+id/textView_onboarding2"
        style="@style/Memento.OnboardingBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="75dp"
        android:gravity="center_horizontal"
        android:lineSpacingMultiplier="0.75"
        android:text="@string/onboarding_main_2"
        app:layout_constraintBottom_toTopOf="@+id/button_onboarding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView_onboarding"
        app:layout_constraintWidth_percent="0.8" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_onboarding"
        style="@style/Memento.BigButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="@string/onboarding_main_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>