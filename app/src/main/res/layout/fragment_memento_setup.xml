<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MementoSetup" >

    <TextView
        android:id="@+id/textView_notice_title"
        style="@style/Memento.OnboardingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:gravity="center_horizontal"
        android:lineSpacingMultiplier="0.75"
        android:shadowColor="@android:color/darker_gray"
        android:shadowDy="8"
        android:shadowRadius="4"
        android:text="@string/onboarding_notice"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8" />

    <TextView
        android:id="@+id/textView_notice_instr"
        style="@style/Memento.OnboardingBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:gravity="center_horizontal"
        android:lineSpacingMultiplier="0.75"
        android:text="@string/onboarding_notice_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_notice_title"
        app:layout_constraintWidth_percent="0.7" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_notice"
        style="@style/Memento.BigButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="@string/onboarding_notice_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TableLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/button_notice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_notice_instr"
        app:layout_constraintWidth_percent="0.75">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="8dp" >

            <ImageView
                android:id="@+id/image_track_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:src="@drawable/track_location"
                app:tint="@color/mem_toolbar"
                android:contentDescription="@string/icon_location" />

            <TextView
                android:id="@+id/textView_trackLocation"
                style="@style/Memento.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:text="@string/fields_track_location"
                tools:ignore="RtlSymmetry" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_location"
                style="@style/Memento.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/image_track_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:src="@drawable/track_weather"
                app:tint="@color/mem_toolbar"
                android:contentDescription="@string/icon_weather" />

            <TextView
                android:id="@+id/textView_trackWeather"
                style="@style/Memento.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:text="@string/fields_track_weather"
                tools:ignore="RtlSymmetry" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_weather"
                style="@style/Memento.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/image_track_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:src="@drawable/mood_happy"
                app:tint="@color/mem_toolbar"
                android:contentDescription="@string/icon_mood" />

            <TextView
                android:id="@+id/textView_trackMood"
                style="@style/Memento.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:text="@string/fields_track_mood"
                tools:ignore="RtlSymmetry" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_mood"
                style="@style/Memento.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/image_track_activity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:src="@drawable/track_exercise"
                app:tint="@color/mem_toolbar"
                android:contentDescription="@string/icon_exercise" />

            <TextView
                android:id="@+id/textView_trackActivity"
                style="@style/Memento.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:paddingStart="10dp"
                android:text="@string/fields_track_activity"
                tools:ignore="RtlSymmetry" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_activity"
                style="@style/Memento.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" />

        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>